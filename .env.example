# Discord application credentials
DISCORD_TOKEN=replace_with_bot_token
DISCORD_CLIENT_ID=replace_with_application_client_id
# Optional: set this for instant guild-scoped command updates while testing
DISCORD_GUILD_ID=replace_with_test_guild_id
# Comma-separated Discord user IDs allowed to use /admin
ADMIN_USER_IDS=replace_with_admin_user_id
# Production persistence; leave empty to use JSON development fallback
DATABASE_URL=postgresql://frs:change_me_in_local_env@localhost:5432/football_rising_star
# Optional: runtime data path used only when DATABASE_URL is empty
DATA_FILE=./data/players.json
